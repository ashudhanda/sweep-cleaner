    <path
        android:fillColor="#FBBF24"
        android:pathData="M 64,28 Q 64,31 61,31 Q 64,31 64,34 Q 64,31 67,31 Q 64,31 64,28 Z" />

    <!-- Tertiary tiny glint -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 82,47 Q 82,49 80,49 Q 82,49 82,51 Q 82,49 84,49 Q 82,49 82,47 Z" />

</vector>
