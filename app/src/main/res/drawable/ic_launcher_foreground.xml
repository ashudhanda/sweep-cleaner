    <!-- Subtle glow behind the broom head and sparkles -->
    <path
        android:pathData="M 54,54 m -24,0 a 24,24 0 1,0 48,0 a 24,24 0 1,0 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="56"
                android:centerY="52"
                android:gradientRadius="24"
                android:type="radial">
                <item android:color="#262DD4BF" android:offset="0.0" />
                <item android:color="#002DD4BF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sweeping curved motion trail (mint teal to glowing white) -->
    <path
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 33,68 C 41,74 53,74 65,66 C 73,59 77,50 80,41">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="33"
                android:startY="74"
                android:endX="80"
                android:endY="41"
                android:type="linear">
                <item android:color="#002DD4BF" android:offset="0.0" />
                <item android:color="#2DD4BF" android:offset="0.6" />
                <item android:color="#FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Secondary outer clean wave -->
    <path
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 28,62 C 34,70 46,75 58,74">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="28"
                android:startY="62"
                android:endX="58"
                android:endY="74"
                android:type="linear">
                <item android:color="#0014B8A6" android:offset="0.0" />
                <item android:color="#4D14B8A6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Broom / Sweeper handle (modern sleek stylus angle) -->
    <path
        android:fillColor="#E2E8F0"
        android:pathData="M 40,36 L 44,32 L 64,52 L 60,56 Z" />

