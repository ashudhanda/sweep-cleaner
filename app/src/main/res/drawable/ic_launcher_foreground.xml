                <item android:color="#0D9488" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bristle detail stripes -->
    <path
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 65,54 L 71,62 M 68,51 L 74,58" />

