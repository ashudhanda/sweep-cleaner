        android:pathData="M 58,54 L 66,46 L 70,50 L 62,58 Z" />

    <!-- Sweeper Bristles Head (Vibrant Teal Fan) -->
    <path
        android:pathData="M 62,56 C 66,52 70,48 74,47 C 77,53 76,61 68,69 C 64,68 62,63 62,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="62"
                android:startY="47"
                android:endX="74"
                android:endY="69"
                android:type="linear">
